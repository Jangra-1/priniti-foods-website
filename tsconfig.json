{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@theme/*": ["./theme/priniti/assets/src/js/*"],
      "@/*": ["./reference/nextjs/*"]
    }
  },
  "include": ["theme/priniti/assets/src/js/**/*", "tools/import/src/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "reference"]
}
