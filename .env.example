# Copy to .env for local use. .env is gitignored: never commit credentials.
#
# Base URL of the WordPress site the import tool reads from.
WP_BASE_URL=https://shop.prinitifoods.com
#
# Optional WordPress Application Password (only needed OUTSIDE the Claude cloud environment,
# where the proxy injects credentials for shop.prinitifoods.com automatically).
# WP_APP_USER=
# WP_APP_PASSWORD=
#
# The import tool refuses to write unless BOTH of these are set and --apply is passed.
# PRINITI_IMPORT_ALLOW_WRITE=0
